# Copy to .env.local and fill in. Never commit real keys.
ANTHROPIC_API_KEY=

# Skill sourcing (optional — each source is skipped if its key is missing)
# SkillsMP: optional — works anonymously (~50 searches/day). A free key (skillsmp.com/developers) raises it to ~500/day
SKILLSMP_API_KEY=
# skills.sh: either a key (request via skills-api@vercel.com) or Vercel OIDC enabled on the project
SKILLS_SH_API_KEY=

# Optional model override for the skill pipeline (defaults to claude-sonnet-5-5 with fallbacks)
APA_SKILLS_MODEL=
